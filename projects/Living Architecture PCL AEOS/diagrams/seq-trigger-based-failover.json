    { "from": "watcher", "to": "watcher", "label": "8. RESTAURAÇÃO DE REDE (Network Online)", "type": "alert" },
    { "from": "watcher", "to": "lmstudio", "label": "9. Dispara on_online_event.ps1 (lms unload --all)", "type": "action" },
