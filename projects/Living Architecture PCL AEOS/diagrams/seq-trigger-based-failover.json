  "messages": [
    { "from": "watcher", "to": "cloud_api", "label": "1. Ping Health Check (Cada 10s)", "type": "status" },
    { "from": "paperclip", "to": "omniroute", "label": "2. Requisição de Inferência (Model *)", "type": "normal" },
    { "from": "omniroute", "to": "cloud_api", "label": "3. Roteamento Nuvem (VRAM Local = 0 MB)", "type": "normal" },
    { "from": "watcher", "to": "watcher", "label": "4. DETECÇÃO DE QUEDA (Network Offline)", "type": "alert" },
    { "from": "watcher", "to": "lmstudio", "label": "5. Dispara on_offline_event.ps1 (lms load --gpu max)", "type": "action" },
    { "from": "lmstudio", "to": "lmstudio", "label": "6. Aloca Qwen2.5-Coder na GPU (~5.3 GB VRAM)", "type": "status" },
