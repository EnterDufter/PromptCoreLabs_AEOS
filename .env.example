# ==============================================================================
# PCL AEOS - Arquivo de Configuração de Ambiente (.env)
# Princípios: Zero Trust, Soberania Local, Isolamento de Rede e Portabilidade
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados Soberano (PostgreSQL 17 + PGVector)
# ------------------------------------------------------------------------------
# ATENÇÃO: Altere a senha padrão antes de iniciar qualquer serviço em produção!
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=paperclip_secure_password_2026_change_me
POSTGRES_DB=paperclip
POSTGRES_PORT=5432
# Endereço de bind de rede no host (127.0.0.1 garante isolamento contra acesso externo)
DB_BIND_ADDRESS=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Gateway OmniRoute (Porta 20130)
# ------------------------------------------------------------------------------
OMNIROUTE_PORT=20130
OMNIROUTE_BIND_ADDRESS=127.0.0.1
OMNIROUTE_INITIAL_PASSWORD=admin_secure_omniroute_2026
# Controles de Autenticação Zero Trust (0 = Autenticação Ativada, 1 = Desativada)
OMNIROUTE_AUTH_DISABLED=0
OMNIROUTE_SKIP_LOGIN=0
OMNIROUTE_REQUIRE_LOGIN=true

# ------------------------------------------------------------------------------
# 3. PaperClip Core & Dashboard (Porta 3100)
# ------------------------------------------------------------------------------
PAPERCLIP_PORT=3100
PAPERCLIP_BIND_ADDRESS=127.0.0.1
BETTER_AUTH_SECRET=paperclip-secret-auth-key-2026-secure

# ------------------------------------------------------------------------------
# 4. Coprocessador LAYA System One (Porta 20140 / stdio MCP)
# ------------------------------------------------------------------------------
LAYA_PORT=20140
LAYA_BIND_ADDRESS=127.0.0.1
LAYA_CPU_THREADS=2
# Se definido como 1, a probe /ready falha (HTTP 503) se o modelo ONNX neural não carregar
LAYA_REQUIRE_NEURAL=0
