# ==============================================================================
# PCL AEOS - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE & SEGREDO (ZERO SECRET LEAK)
# Copie este arquivo para .env no mesmo diretório e preencha suas chaves.
# ==============================================================================

# --- CLOUDFLARE CREDENTIALS ---
CLOUDFLARE_API_TOKEN="seu-api-token-aqui"
CLOUDFLARE_ACCOUNT_ID="seu-account-id-aqui"
CLOUDFLARE_R2_BUCKET="pcl-aeos-backups"

# --- BACKUP ENCRYPTION (AES-256) ---
BACKUP_ENCRYPTION_KEY="sua-chave-secreta-mestram-aes-256"

# --- LOCAL INFRASTRUCTURE ---
DB_CONTAINER_NAME="pcl-db"
DB_USER="paperclip"
DB_NAME="paperclip"
LOCAL_DOCS_DIR="c:\PromptCore_Labs"
RCLONE_REMOTE_NAME="r2-backup"
