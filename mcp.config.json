{
  "$schema": "https://json.schemastore.org/mcp-config.json",
  "mcpServers": {
    "pcl-cortex": {
      "command": "node",
      "args": [
        "./mcp/pcl-cortex/src/index.js"
      ],
      "env": {
        "OMNI_ROUTE_URL": "http://localhost:20130"
      },
      "disabled": false,
      "autoApprove": []
    },
    "gemini-notebooklm": {
      "command": "node",
      "args": [
        "./mcp/gemini-notebooklm/src/index.js"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "tlc-agent-skills": {
      "command": "npx",
      "args": [
        "-y",
        "@tech-leads-club/agent-skills",
        "mcp"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    }
  }
}
